<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/create_title"
            android:textColor="@color/pink_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp"
            android:text="@string/create_subtitle"
            android:textColor="@color/text_dim"
            android:textSize="16sp" />

        <!-- Карточка: Парень -->
        <LinearLayout
            android:id="@+id/cardBoy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:background="@drawable/bg_gender_normal"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👦"
                android:textSize="44sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Парень"
                android:textColor="@color/text_light"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Карточка: Девушка -->
        <LinearLayout
            android:id="@+id/cardGirl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:background="@drawable/bg_gender_normal"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👧"
                android:textSize="44sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Девушка"
                android:textColor="@color/text_light"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Поле имени -->
        <EditText
            android:id="@+id/editName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/name_hint"
            android:textColorHint="@color/text_dim"
            android:textColor="@color/text_light"
            android:textSize="18sp"
            android:background="@drawable/bg_input"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="20"
            android:maxLines="1"
            android:layout_marginBottom="28dp" />

        <!-- Кнопка старт -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_start_story"
            android:textColor="@color/text_light"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_pink"
            android:stateListAnimator="@null"
            android:elevation="0dp" />

    </LinearLayout>

</ScrollView>
